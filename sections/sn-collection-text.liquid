{%- comment -%}
  Snosha — collection text (collection templates). Reference: live snosha.com collection page, 2026-11-26.
  One section type for the text above the products and the text after them, chosen by "Content":
    - Collection description  → Admin → Collections → the collection → Description
    - Bottom text metafield   → collection metafield custom.bottom_text (Rich text or Multi-line text)
  Each collection shows its own text; the "Default text" (Theme Editor) is used when that collection has none.
  Nothing is rendered when there is no text at all. Styles: assets/main.css (.sn-col-text).
{%- endcomment -%}

{%- liquid
  assign sn_collection = collection
  assign sn_text = ''

  if section.settings.source == 'description'
    assign sn_text = sn_collection.description
  else
    assign sn_field = sn_collection.metafields.custom.bottom_text
    if sn_field != blank
      if sn_field.type == 'rich_text_field'
        assign sn_text = sn_field | metafield_tag
      else
        assign sn_text = sn_field.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
      endif
    endif
  endif

  if sn_text == blank
    assign sn_text = section.settings.default_text
  endif
-%}

{%- if sn_text != blank -%}
  <div
    class="sn-col-text"
    style="
      --sn-ct-color: {{ section.settings.text_color }};
      --sn-ct-size: {{ section.settings.font_size }}px;
      --sn-ct-size-mobile: {{ section.settings.font_size_mobile }}px;
      --sn-ct-max: {{ section.settings.max_width }}px;
      --sn-ct-align: {{ section.settings.alignment }};
      --sn-ct-pad-start: {{ section.settings.padding_top }}px;
      --sn-ct-pad-end: {{ section.settings.padding_bottom }}px;
      --sn-ct-pad-start-mobile: {{ section.settings.padding_top_mobile }}px;
      --sn-ct-pad-end-mobile: {{ section.settings.padding_bottom_mobile }}px;
      {%- if section.settings.background_color != blank and section.settings.background_color.alpha > 0 -%}
        --sn-ct-bg: {{ section.settings.background_color }};
      {%- endif -%}
    "
  >
    <div class="sn-col-text__inner rte">
      {{ sn_text }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection text",
  "tag": "section",
  "class": "sn-col-text-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Content",
      "options": [
        { "value": "description", "label": "Collection description (top text)" },
        { "value": "bottom", "label": "Bottom text (metafield custom.bottom_text)" }
      ],
      "default": "description"
    },
    {
      "type": "richtext",
      "id": "default_text",
      "label": "Default text",
      "info": "Shown when the collection has no text of its own. Leave empty to hide the section then."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#176bb0"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size — desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Text size — mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Text width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom — desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection text"
    }
  ]
}
{% endschema %}
