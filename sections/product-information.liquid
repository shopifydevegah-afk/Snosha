

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'deferred-media-product-model-styles' %}
{% render 'deferred-media-video-styles' %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% render 'fly-to-cart-styles' %}

  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  {%- liquid
    # Project extension (Snosha, opt-in "Sticky bar style: Full-width bar"): full-width bar with a quantity control
    # that drives the main form's own quantity selector, own label and icon toggle. Floating card = native.
    assign sn_sticky_bar = false
    if section.settings.sn_sticky_style == 'bar'
      assign sn_sticky_bar = true
    endif
    assign sn_sticky_icon = true
    if sn_sticky_bar and section.settings.sn_sticky_show_icon == false
      assign sn_sticky_icon = false
    endif
    assign sn_sticky_quantity = false
    if sn_sticky_bar and section.settings.sn_sticky_show_quantity
      assign sn_sticky_quantity = true
    endif
  -%}
  <sticky-add-to-cart
    class="sticky-add-to-cart{% if sn_sticky_bar %} sn-sticky-bar{% unless section.settings.sn_sticky_show_image %} sn-sticky-bar--no-image{% endunless %}{% unless section.settings.sn_sticky_show_compare %} sn-sticky-bar--no-compare{% endunless %}{% if section.settings.sn_sticky_quantity_mobile %} sn-sticky-bar--quantity-mobile{% endif %}{% endif %}"
    {% if sn_sticky_bar %}
      style="--sn-sticky-bg: {{ section.settings.sn_sticky_background }}; --sn-sticky-width: {{ section.settings.sn_sticky_width }}px; --sn-sticky-padding: {{ section.settings.sn_sticky_padding }}px; --sn-sticky-padding-mobile: {{ section.settings.sn_sticky_padding_mobile }}px; --sn-sticky-image: {{ section.settings.sn_sticky_image_size }}px; --sn-sticky-button-width: {{ section.settings.sn_sticky_button_width }}px; --sn-sticky-button-height: {{ section.settings.sn_sticky_button_height }}px; --sn-sticky-button-height-mobile: {{ section.settings.sn_sticky_button_height_mobile }}px; --sn-sticky-image-mobile: {{ section.settings.sn_sticky_image_size_mobile }}px; --sn-sticky-plus-bg: {{ section.settings.sn_sticky_plus_bg }};{% if section.settings.sn_sticky_plus_color != blank %} --sn-sticky-plus-color: {{ section.settings.sn_sticky_plus_color }};{% endif %} --sn-sticky-qty-button: {{ section.settings.sn_sticky_qty_button }}px; --sn-sticky-qty-button-mobile: {{ section.settings.sn_sticky_qty_button_mobile }}px; --sn-sticky-qty-padding: {{ section.settings.sn_sticky_qty_padding }}px; --sn-sticky-qty-gap: {{ section.settings.sn_sticky_qty_gap }}px;{% unless section.settings.sn_sticky_shadow %} --sn-sticky-shadow: none;{% endunless %}"
    {% endif %}
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-custom-popover"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      {%- if sn_sticky_quantity and current_variant.available -%}
        {%- comment -%}
          Quantity control of the full-width bar: its buttons call the MAIN product form's quantity selector
          (same min / max / step rules); the number is the bar's own quantityNumber ref, kept in sync by
          sticky-add-to-cart.js. The sticky button then submits the main form, so quantity and variant match.
          Visual order "− 1 +" left to right, as the reference.
        {%- endcomment -%}
        {%- capture sn_main_quantity -%}#shopify-section-{{ section.id }} .product-details quantity-selector-component{%- endcapture -%}
        <div
          class="sticky-add-to-cart__quantity"
          dir="ltr"
        >
          <button
            type="button"
            class="sticky-add-to-cart__quantity-button"
            aria-label="{{ 'accessibility.decrease_quantity' | t }}"
            on:click="{{ sn_main_quantity }}/decreaseQuantity"
          >
            <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
          </button>
          <span
            class="sticky-add-to-cart__quantity-value"
            ref="quantityNumber"
            aria-live="polite"
          >
            {{- initial_quantity -}}
          </span>
          <button
            type="button"
            class="sticky-add-to-cart__quantity-button sticky-add-to-cart__quantity-button--plus"
            aria-label="{{ 'accessibility.increase_quantity' | t }}"
            on:click="{{ sn_main_quantity }}/increaseQuantity"
          >
            <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available and sn_sticky_icon %}
            <span class="svg-wrapper">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available and sn_sticky_bar and section.settings.sn_sticky_label != blank -%}
                {{- section.settings.sn_sticky_label | escape -}}
              {%- elsif current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {%- unless sn_sticky_quantity and current_variant.available -%}
                {{- ' (' -}}
                <span ref="quantityNumber">{{- initial_quantity -}}</span>
                {{- ')' -}}
              {%- endunless -%}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>

  {% render 'add-to-cart-button-styles' %}
{% endif %}

{%- comment -%}
  Project extension (Snosha product page): "Snosha layout" settings as CSS custom properties, read by the scoped
  CSS of the custom class (assets/dev1.css). Output only when a custom class is set; blank = native section.
{%- endcomment -%}
{%- if section.settings.custom_class != blank -%}
  {%- assign s = section.settings -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      --sn-gallery-width: {{ s.sn_gallery_width }}%;
      --sn-columns-gap: {{ s.sn_columns_gap }}px;
      --sn-benefit-tile: {{ s.sn_benefit_tile }}px;
      --sn-benefit-tile-mobile: {{ s.sn_benefit_tile_mobile }}px;
      --sn-swatch-size: {{ s.sn_swatch_size }}px;
      --sn-swatch-dot: {{ s.sn_swatch_dot }}px;
      --sn-swatch-gap: {{ s.sn_swatch_gap }}px;
      --sn-swatch-label-gap: {{ s.sn_swatch_label_gap }}px;
      --sn-button-height: {{ s.sn_button_height }}px;
      --sn-button-height-mobile: {{ s.sn_button_height_mobile }}px;
      --sn-purchase-gap: {{ s.sn_purchase_gap }}px;
      --sn-purchase-gap-mobile: {{ s.sn_purchase_gap_mobile }}px;
      --sn-trust-pad-start: {{ s.sn_trust_pad_start }}px;
      --sn-trust-pad-start-mobile: {{ s.sn_trust_pad_start_mobile }}px;
      --sn-trust-pad-end: {{ s.sn_trust_pad_end }}px;
      --sn-trust-pad-end-mobile: {{ s.sn_trust_pad_end_mobile }}px;
      --sn-trust-pad-block: {{ s.sn_trust_pad_block }}px;
      --sn-trust-pad-block-mobile: {{ s.sn_trust_pad_block_mobile }}px;
      --sn-trust-tile: {{ s.sn_trust_tile }}px;
      --sn-swatch-legend-gap: {{ s.sn_swatch_legend_gap }}px;
      --sn-trust-text: {{ s.sn_trust_text }}px;
      --sn-trust-text-mobile: {{ s.sn_trust_text_mobile }}px;
      --sn-xsell-thumb: {{ s.sn_xsell_thumb }}px;
      --sn-xsell-pad-block: {{ s.sn_xsell_pad_block }}px;
      --sn-xsell-pad-start: {{ s.sn_xsell_pad_start }}px;
      --sn-xsell-pad-end: {{ s.sn_xsell_pad_end }}px;
      --sn-xsell-add: {{ s.sn_xsell_add }}px;
      --sn-acc-tile: {{ s.sn_acc_tile }}px;
      --sn-acc-heading-mobile: {{ s.sn_acc_heading_mobile }}px;
      --sn-acc-title-line: {{ s.sn_acc_title_line }}px;
      --sn-acc-paragraph-gap: {{ s.sn_acc_paragraph_gap }}px;
      --sn-trust-height: {{ s.sn_trust_height }}px;
      --sn-trust-height-mobile: {{ s.sn_trust_height_mobile }}px;
      --sn-acc-body: {{ s.sn_acc_body }}px;
      --sn-acc-body-mobile: {{ s.sn_acc_body_mobile }}px;
      --sn-acc-body-line: {{ s.sn_acc_body_line }}px;
      --sn-acc-body-line-mobile: {{ s.sn_acc_body_line_mobile }}px;
      --sn-acc-body-weight: {{ s.sn_acc_body_weight }};
      --sn-acc-body-weight-mobile: {{ s.sn_acc_body_weight_mobile }};
      --sn-acc-bold-weight: {{ s.sn_acc_bold_weight }};
      --sn-acc-body-color: {{ s.sn_acc_body_color }};
      --sn-acc-bold-size: {{ s.sn_acc_bold_size }}px;
      --sn-acc-bold-size-mobile: {{ s.sn_acc_bold_size_mobile }}px;
      --sn-acc-bold-color: {{ s.sn_acc_bold_color }};
      --sn-acc-bold-gap: {{ s.sn_acc_bold_gap }}px;
      --sn-acc-bold-gap-mobile: {{ s.sn_acc_bold_gap_mobile }}px;
      --sn-acc-paragraph-gap-mobile: {{ s.sn_acc_paragraph_gap_mobile }}px;
    }
    {%- comment -%} Trust icon size (0 = each icon block's own Width): uploaded icons carry an inline width, hence !important {%- endcomment -%}
    {%- if s.sn_trust_icon > 0 %}
    #shopify-section-{{ section.id }} .sn-product-trust .icon-block__media {
      width: {{ s.sn_trust_icon }}px !important;
      height: auto;
    }
    {%- endif %}
    {%- if s.sn_trust_icon_mobile > 0 %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .sn-product-trust .icon-block__media {
        width: {{ s.sn_trust_icon_mobile }}px !important;
      }
    }
    {%- endif %}
  {% endstyle %}
{%- endif -%}

{% render 'product-information-content',
  product: closest.product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: max(20px, var(--safe-area-inset-bottom));
    left: 50%; /* stylelint-disable-line csstools/use-logical -- centring pair with a physical translateX(-50%) */
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-inline-start: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;

      /* Full-bleed bar touches the physical bottom edge (viewport-fit=cover); keep the
         controls above the home indicator while the background fills the safe area */
      padding-block-end: calc(var(--padding-sm) + var(--safe-area-inset-bottom));

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-inline-start: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.direction_start"
        },
        {
          "value": "right",
          "label": "t:options.direction_end"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "select",
      "id": "sn_sticky_style",
      "label": "Sticky bar style",
      "options": [
        {
          "value": "floating",
          "label": "Floating card"
        },
        {
          "value": "bar",
          "label": "Full-width bar"
        }
      ],
      "default": "floating",
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart }}"
    },
    {
      "type": "text",
      "id": "sn_sticky_label",
      "label": "Sticky button label",
      "info": "Shown while the product can be added. Empty = theme translation.",
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_show_icon",
      "label": "Show cart icon on the sticky button",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_show_quantity",
      "label": "Show quantity",
      "info": "Changes the quantity of the main product form.",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_quantity_mobile",
      "label": "Show quantity on mobile",
      "default": false,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_show_image",
      "label": "Show product image",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_show_compare",
      "label": "Show compare-at price",
      "default": true,
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "color",
      "id": "sn_sticky_background",
      "label": "Sticky bar background",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_sticky_add_to_cart and section.settings.sn_sticky_style == 'bar' }}"
    },
    {
      "type": "checkbox",
      "id": "sn_sticky_shadow",
