
@font-face {
  font-family: "Cairo Custom";
  src: url("{{ 'cairo-variable.woff2' | asset_url }}") format("woff2");
  font-weight: 200 1000;
  font-style: normal;
  font-display: swap;
}

:root {
  --font-body--family: "Cairo Custom", sans-serif;
  --font-heading--family: "Cairo Custom", sans-serif;
  --font-subheading--family: "Cairo Custom", sans-serif;
  --font-accent--family: "Cairo Custom", sans-serif;
}
