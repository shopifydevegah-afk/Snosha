{%- comment -%} Snosha (opt-in): phone font size, exact line height and weight, passed as CSS vars only when the section has a custom class; consumed by that class's CSS. {%- endcomment -%}
{%- if section.settings.custom_class != blank and block.settings.type_preset == 'custom' -%}
  {% style %}
    .text-block--{{ block.id }} {
      --sn-mobile-font-size: {{ block.settings.mobile_font_size }}px;
      --sn-line-height: {{ block.settings.line_height_exact | divided_by: 100.0 }};
      {%- if block.settings.line_height_exact_mobile > 0 %} --sn-line-height-mobile: {{ block.settings.line_height_exact_mobile | divided_by: 100.0 }};{% endif %}
      {%- if block.settings.alignment_mobile != blank %} --sn-text-align-mobile: {{ block.settings.alignment_mobile }};{% endif %}
      {%- if block.settings.font_weight != blank %} --sn-font-weight: {{ block.settings.font_weight }};{% endif %}
    }
  {% endstyle %}
{%- endif -%}
{%- capture custom_class -%}{% render 'custom-class', value: block.settings.custom_class %}{%- endcapture -%}
{% render 'text', block: block, class: custom_class %}
{% render 'text-responsive-style', block: block %}

