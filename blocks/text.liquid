

{%- capture custom_class -%}{% render 'custom-class', value: block.settings.custom_class %}{%- endcapture -%}
{% render 'text', block: block, class: custom_class %}
{%- liquid
  # Opt-in: line limit and mobile size. All default to 0 (= native, nothing output).
  assign bs = block.settings
  assign max_lines_mobile = bs.max_lines_mobile
  if max_lines_mobile == 0
    assign max_lines_mobile = bs.max_lines
  endif
-%}
{%- if bs.max_lines > 0 or bs.max_lines_mobile > 0 or bs.font_size_mobile > 0 or bs.line_height_mobile > 0 -%}
  {%- capture text_scope -%}#shopify-section-{{ section.id }} .text-block--{{ block.id }}{%- endcapture -%}
  {%- capture clamp_excerpt -%}
    /* Rich text flows as one excerpt so the line limit applies to the whole text */
    {{ text_scope }} {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-align: var(--text-align, var(--text-align-default));
    }
    {{ text_scope }} > * {
      display: inline;
      margin: 0;
    }
    {{ text_scope }} :is(img, picture, video, iframe, table, svg, hr, br) {
      display: none;
    }
    {{ text_scope }} > *:not(:last-child)::after {
      content: ' ';
    }
  {%- endcapture -%}
  {% style %}
    {%- if bs.max_lines > 0 %}
      {{ clamp_excerpt }}
      {{ text_scope }} {
        -webkit-line-clamp: {{ bs.max_lines }};
        line-clamp: {{ bs.max_lines }};
      }
    {%- endif %}
    @media screen and (max-width: 749px) {
      {%- if max_lines_mobile > 0 and bs.max_lines == 0 %}
        {{ clamp_excerpt }}
      {%- endif %}
      {{ text_scope }} {
        {%- if max_lines_mobile > 0 %}
          -webkit-line-clamp: {{ max_lines_mobile }};
          line-clamp: {{ max_lines_mobile }};
        {%- endif %}
        {%- if bs.font_size_mobile > 0 %}font-size: {{ bs.font_size_mobile }}px;{% endif %}
        {%- if bs.line_height_mobile > 0 %}line-height: {{ bs.line_height_mobile }}px;{% endif %}
      }
      {%- if bs.font_size_mobile > 0 or bs.line_height_mobile > 0 %}
        {{ text_scope }} > * {
          font-size: inherit;
          line-height: inherit;
        }
      {%- endif %}
    }
  {% endstyle %}
{%- endif -%}

