

{%- doc -%}
  @param {string} [product_view_context] - Context value passed through to the card snippet.
{%- enddoc -%}

{% liquid
  assign product = closest.product
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product, product_view_context: product_view_context %}
{%- liquid
  # Opt-in card overrides. Badge sizes only affect the opt-in product badge of the image block.
  assign bs = block.settings
  assign card_scope = '#shopify-section-' | append: section.id | append: ' #product-card-' | append: block.id
-%}
{%- if bs.border_radius_mobile_custom or bs.badge_font_size != 13 -%}
  {% style %}
    {%- if bs.badge_font_size != 13 %}
      {{ card_scope }} {
        --custom-badge-font-size: {{ bs.badge_font_size }}px;
      }
    {%- endif %}
    {%- if bs.border_radius_mobile_custom %}
      @media screen and (max-width: 749px) {
        {{ card_scope }} {
          --custom-badge-font-size-mobile: {{ bs.badge_font_size_mobile }}px;
          --custom-badge-radius-scale-mobile: {{ bs.badge_font_size_mobile | times: 1.0 | divided_by: bs.badge_font_size | round: 3 }};
        }
        {{ card_scope }} > .product-card__content {
          gap: {{ bs.product_card_gap_mobile }}px;
          border-radius: {{ bs.border_radius_mobile }}px;
          {% if bs.border_radius_mobile > 0 %}overflow: clip;{% endif %}
        }
      }
    {%- endif %}
  {% endstyle %}
{%- endif -%}
{% render 'quantity-selector-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'gift-card-recipient-form-styles' %}
{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_card",
  "blocks": [
    {
      "type": "_product-card-group"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "price"
    },
    {
      "type": "review"
    },
    {
      "type": "sku"
    },
    {
      "type": "swatches"
    },
    {
      "type": "_product-card-gallery"
    },
    {
      "type": "product-title"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_card"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Product badge text size",
      "info": "For the product badge set in the product image block. Padding and corners scale with it.",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "border_radius_mobile_custom",
      "label": "Customize mobile card",
      "info": "Separate mobile corner radius, spacing and badge size.",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius_mobile",
      "label": "Mobile corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.border_radius_mobile_custom }}"
    },
    {
      "type": "range",
      "id": "product_card_gap_mobile",
      "label": "Mobile vertical gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.border_radius_mobile_custom }}"
    },
    {
      "type": "range",
      "id": "badge_font_size_mobile",
      "label": "Mobile product badge text size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13,
      "visible_if": "{{ block.settings.border_radius_mobile_custom }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
