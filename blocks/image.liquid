

{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{%- comment -%}
  Snosha (opt-in, sections with a custom class): "Fixed width" (px, 0 = native sizing) for icons and small
  artwork, and no stock placeholder on the live store when no image is picked (the editor still shows it).
{%- endcomment -%}
{%- liquid
  assign sn_opt_in = false
  if section.settings.custom_class != blank
    assign sn_opt_in = true
  endif
  assign sn_fixed = false
  if sn_opt_in and block_settings.fixed_width > 0
    assign sn_fixed = true
  endif
  assign sn_fixed_mobile = block_settings.fixed_width_mobile | default: 0
  if sn_fixed_mobile == 0
    assign sn_fixed_mobile = block_settings.fixed_width
  endif
-%}

{%- comment -%}
  Snosha (Dev1, opt-in, sections with a custom class): optional mobile image (below 750px, falls back to the image)
  and image fit (contain / cover). Unset = native output.
{%- endcomment -%}
{%- liquid
  assign sn_mobile_image = blank
  if sn_opt_in and block_settings.image_mobile != blank
    assign sn_mobile_image = block_settings.image_mobile
  endif
  assign sn_fit = ''
  if sn_opt_in and block_settings.image_fit != blank and block_settings.image_fit != 'native'
    assign sn_fit = block_settings.image_fit
  endif
-%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style{% if sn_fixed %} image-block--sn-fixed{% endif %}{% if sn_fit != blank %} image-block--sn-fit{% endif %}
{% endcapture %}

{% capture style %}
  {%- if sn_fixed %}--sn-image-width: {{ block_settings.fixed_width }}px; --sn-image-width-mobile: {{ sn_fixed_mobile }}px;{% endif %}
  {%- if sn_fit != blank %} --sn-image-fit: {{ sn_fit }};{% endif %}
  --ratio: {{ ratio }};
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'

  # Snosha: home hero product image (section class sn-home-hero). It renders in section 1, so it loads
  # eagerly and the browser ignores `auto`, falling back to 100vw. Upper bound of its rendered width
  # from dev1.css (.sn-home-hero-stage): stage 56.06% of a 1376px row from 990px, 480px max below;
  # the image is 94.47% / 98.9% of the stage. Update together with that CSS.
  # Its image was measured as the home page LCP element (DevTools, 2026-11-24), so it alone gets high priority.
  assign sn_fetchpriority = 'auto'
  assign sn_section_classes = section.settings.custom_class | split: ' '
  if sn_section_classes contains 'sn-home-hero'
    assign sizes = 'auto, (min-width: 990px) min(56.06vw, 772px), min(100vw, 480px)'
    assign sn_fetchpriority = 'high'
  endif
%}

{% capture image %}
  {%- if block_settings.image -%}
    {%- if sn_mobile_image != blank -%}
      <picture class="image-block__picture">
        <source
          media="(max-width: 749px)"
          srcset="{{ sn_mobile_image | image_url: width: 750 }} 750w, {{ sn_mobile_image | image_url: width: 1100 }} 1100w, {{ sn_mobile_image | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="{{ sn_mobile_image.width }}"
          height="{{ sn_mobile_image.height }}"
        >
    {%- endif -%}
    {{
      block_settings.image
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image.width,
        widths: widths,
        height: block_settings.image.height,
        class: 'image-block__image border-style',
        style: image_border_style,
        sizes: sizes,
        fetchpriority: sn_fetchpriority
    }}
    {%- if sn_mobile_image != blank -%}
      </picture>
    {%- endif -%}
  {%- else -%}
    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'image-block__placeholder' }}
    </div>
  {%- endif -%}
{% endcapture %}

{% if sn_opt_in and block_settings.image == blank and request.design_mode == false %}
  {%- comment -%} Snosha opt-in: nothing on the live store until the merchant picks an image {%- endcomment -%}
{% elsif block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent's horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }

  /* Snosha opt-in "Image fit" and mobile image (sections with a custom class) */
  .image-block--sn-fit .image-block__image {
    object-fit: var(--sn-image-fit, cover);
  }

  .image-block__picture {
    display: contents;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown below 750px in sections with a custom class; empty = the image above."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "native",
          "label": "Theme default"
        },
        {
          "value": "contain",
          "label": "Contain (whole image)"
        },
        {
          "value": "cover",
          "label": "Cover (fill the frame)"
        }
      ],
      "default": "native",
      "info": "In sections with a custom class."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "fixed_width",
      "label": "Fixed width",
      "info": "0 = use the width above. For icons/artwork, in sections with a custom class.",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "fixed_width_mobile",
      "label": "Fixed width (mobile)",
      "info": "0 = same as Fixed width.",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
