
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
    --copyright-font-weight: {{ block_settings.font_weight | default: 400 }};
    --copyright-font-size-mobile: {{ block_settings.font_size_mobile | default: 11 }}px;
    --copyright-font-weight-mobile: {{ block_settings.font_weight_mobile | default: 400 }};
  "
  {% if block_settings.text_direction != blank %}
    dir="{{ block_settings.text_direction }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- comment -%}
    The year and the name are each isolated (<bdi>) so the line keeps one predictable order in
    right-to-left and left-to-right text: ©, year, name, then the text after it.
  {%- endcomment -%}
  <span class="footer-utilities__text">
    &copy; <bdi>{{ 'now' | date: '%Y' }}</bdi>
    <bdi>
      {%- if block_settings.brand_text != blank -%}
        {{ block_settings.brand_text | escape | link_to: routes.root_url }}
      {%- else -%}
        {{ shop.name | link_to: routes.root_url }}
      {%- endif -%}
    </bdi>
    {%- if block_settings.suffix_text != blank %} {{ block_settings.suffix_text | escape }}{% endif -%}
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>
</div>

{% stylesheet %}
  .footer-utilities__group-copyright {
    color: var(--color-utilities, var(--color-foreground-muted));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name",
      "info": "Optional. Replaces the store name. The © symbol and the current year are added automatically."
    },
    {
      "type": "text",
      "id": "suffix_text",
      "label": "Text after store name",
      "info": "Optional, e.g. \"— All rights reserved.\" Don't repeat the ©, year or name here: they are added automatically."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Weight (desktop)",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "SemiBold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Size (mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "font_weight_mobile",
      "label": "Weight (mobile)",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "SemiBold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_direction",
      "label": "Text direction",
      "info": "Use \"Right to left\" for an Arabic copyright line so the ©, year, name and text keep the design order.",
      "options": [
        { "value": "", "label": "Same as page" },
        { "value": "rtl", "label": "Right to left" },
        { "value": "ltr", "label": "Left to right" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
