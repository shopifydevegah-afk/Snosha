

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{%- comment -%}
  Project extension (Snosha, opt-in): linked colour products. "Colour" child blocks (destination product picker,
  colour name, colour / image). The picker shows these colours as links (each opens its own product page) in
  place of the colour option (option names from "Option names to relabel") when either:
  a) one of the items points at the product being viewed (one product per colour) → that item is selected; or
  b) the product has colour VARIANTS and an item's "Colour name" equals one of its colour values → the item
     matching the selected variant's colour is selected; the others open their own products.
  The native colour inputs stay in the form, hidden, so variant state and Add to cart are untouched. No Colour
  items, or no match = native picker only.
{%- endcomment -%}
{%- capture sn_linked_entries -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{%- liquid
  assign sn_linked_html = ''
  assign sn_linked_option = ''
  assign sn_linked_active = false
  assign sn_current_name = ''

  if product_resource != blank and sn_linked_entries contains 'linked-colors__entry'
    # Colour option of this product (by name)
    assign sn_match_names = block.settings.option_label_match | downcase | split: ','
    for sn_option in product_resource.options_with_values
      assign sn_option_key = sn_option.name | downcase | strip
      for sn_match in sn_match_names
        assign sn_match_key = sn_match | strip
        if sn_match_key == sn_option_key and sn_linked_option == blank
          assign sn_linked_option = sn_option.name
          assign sn_colour_option = sn_option
        endif
      endfor
    endfor

    if sn_linked_entries contains 'aria-current="true"'
      # a) this product is one of the destinations
      assign sn_linked_active = true
      if sn_linked_entries contains '<!--sn-current:'
        assign sn_current_name = sn_linked_entries | split: '<!--sn-current:' | last | split: ':sn-->' | first
      endif
    elsif sn_linked_option != blank
      # b) colour variants: select the item whose "Colour name" is the selected colour value
      for sn_value in sn_colour_option.values
        assign sn_value_key = sn_value.name | downcase | strip | escape
        assign sn_key_attr = 'data-color-key="' | append: sn_value_key | append: '"'
        if sn_linked_entries contains sn_key_attr
          assign sn_linked_active = true
        endif
      endfor
      if sn_linked_active
        assign sn_selected_key = sn_colour_option.selected_value | downcase | strip | escape
        assign sn_key_attr = 'data-color-key="' | append: sn_selected_key | append: '"'
        assign sn_key_current = sn_key_attr | append: ' aria-current="true"'
        assign sn_linked_entries = sn_linked_entries | replace: sn_key_attr, sn_key_current
        assign sn_current_name = sn_colour_option.selected_value | escape
      endif
    elsif request.design_mode
      assign sn_linked_active = true
    endif
  endif

  if sn_linked_active

    assign sn_linked_label = block.settings.option_label
    if sn_linked_label == blank
      assign sn_linked_label = sn_linked_option
    endif

    capture sn_linked_html
      echo '<div class="linked-colors linked-colors--picker" role="group" aria-labelledby="LinkedColors-' | append: block.id | append: '">'
      echo '<p class="linked-colors__legend" id="LinkedColors-' | append: block.id | append: '">'
      echo sn_linked_label | escape
      if sn_current_name != blank
        echo '<span class="linked-colors__value">' | append: sn_current_name | append: '</span>'
      endif
      echo '</p><ul class="linked-colors__list list-unstyled">'
      echo sn_linked_entries
      echo '</ul></div>'
    endcapture
  endif
-%}

{% unless product_resource == blank %}
  {%- comment -%} Product without a colour option (e.g. one product per colour): colours shown on their own {%- endcomment -%}
  {%- if sn_linked_html != blank and sn_linked_option == blank -%}
    <div
      class="linked-colors-wrapper spacing-style"
      style="{% render 'spacing-style', settings: block.settings %}"
    >
      {{ sn_linked_html }}
    </div>
  {%- endif -%}
  {% render 'variant-main-picker',
    product_resource: product_resource,
    section: section,
    product: product,
    linked_colors: sn_linked_html,
    linked_option: sn_linked_option
  %}
{% endunless %}

{% stylesheet %}
  /* Project extension (Snosha, opt-in "Show names under swatches"): name below the swatch; the selected ring
     moves from the label to the swatch so it does not surround the name. Absent names = native rules only. */
  .variant-option__button-label--has-swatch:has(> .variant-option__swatch-name) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xs, 4px);

    &:hover,
    &:has(:checked) {
      outline: none;
    }

    &:has(:checked) .swatch {
      outline: var(--focus-outline-width) solid var(--color-selected-variant-border);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .variant-option__swatch-name {
    font-size: var(--font-size--xs, 0.75rem);
    line-height: 1.6;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "blocks": [
    {
      "type": "_linked-color"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatch_names",
      "label": "Show names under swatches",
      "info": "Each colour's name from its product option value.",
      "default": false,
      "visible_if": "{{ block.settings.show_swatches }}"
    },
    {
      "type": "text",
      "id": "option_label",
      "label": "Option label on the storefront",
      "info": "Replaces the label of the options listed below, e.g. اللون. Leave empty to show the option name from Product Admin. Translate it for other languages in Translate & Adapt (Theme)."
    },
    {
      "type": "text",
      "id": "option_label_match",
      "label": "Option names to relabel",
      "info": "Product Admin option names, separated by commas. Other options keep their own name.",
      "default": "Color, Colour, اللون, لون"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
