

{% assign block_settings = block.settings %}

{%- liquid
  # Opt-in extensions (defaults keep the native output):
  # rows as cards, custom question typography, icon color/size and an uploaded icon image.
  assign icon_style = block_settings.icon
  if icon_style == 'image' and block_settings.icon_image == blank
    assign icon_style = 'caret'
  endif

  assign extra_class = ''
  if block_settings.row_cards
    assign extra_class = extra_class | append: ' accordion--cards'
  elsif block_settings.dividers
    assign extra_class = extra_class | append: ' accordion--dividers'
  endif
  if block_settings.icon_color != blank
    assign extra_class = extra_class | append: ' accordion--icon-color'
  endif
-%}

{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

<div
  class="accordion accordion--{{ block.id }} accordion--{{ icon_style }} border-style spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}{% if block_settings.background_color != blank %} accordion--custom-background{% endif %}{{ extra_class }}"
  style="
    {%- if block_settings.type_preset == 'custom' %}
      --summary-font-family: var(--font-body--family);
      --summary-font-style: var(--font-body--style);
      --summary-font-weight: {{ block_settings.summary_font_weight }};
      --summary-font-size: {{ block_settings.summary_font_size }}px;
      --summary-font-line-height: {{ block_settings.summary_line_height }}px;
      --summary-font-case: none;
    {%- else %}
    --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
     --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
     --summary-font-weight: var(--font-{{ block_settings.type_preset }}--weight);
     --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
     --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
     --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
    {%- endif %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    {% if block_settings.divider_color != blank %} --color-border: {{ block_settings.divider_color }};{% endif %}
    {%- if block_settings.icon_color != blank %} --accordion-icon-color: {{ block_settings.icon_color }};{% endif %}
    {%- if icon_style == 'image' %} --accordion-icon-image: url('{{ block_settings.icon_image | image_url: width: 96 }}');{% endif %}
    {%- if block_settings.row_cards %}
      --accordion-row-gap: {{ block_settings.row_gap }}px;
      --accordion-row-border-width: {{ block_settings.row_border_width }}px;
      --accordion-row-radius: {{ block_settings.row_radius }}px;
      --accordion-row-padding-block: {{ block_settings.row_padding_block }}px;
      --accordion-row-padding-inline: {{ block_settings.row_padding_inline }}px;
      --accordion-row-padding-inline-mobile: {{ block_settings.row_padding_inline_mobile }}px;
      --accordion-summary-gap: {{ block_settings.summary_gap }}px;
      --accordion-content-gap: {{ block_settings.content_gap }}px;
      --accordion-icon-size: {{ block_settings.icon_size }}px;
      {%- if block_settings.row_background != blank %} --accordion-row-background: {{ block_settings.row_background }};{% endif %}
      {%- if block_settings.row_background_open != blank %} --accordion-row-background-open: {{ block_settings.row_background_open }};{% endif %}
      {%- if block_settings.row_border_color != blank %} --accordion-row-border-color: {{ block_settings.row_border_color }};{% endif %}
    {%- endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% render 'accordion-styles' %}

{% stylesheet %}
  /* Opt-in icon color */
  .accordion--icon-color summary .svg-wrapper {
    color: var(--accordion-icon-color);
  }

  /* Opt-in uploaded icon: replaces the caret and turns like it when the row opens */
  .accordion--image .icon-plus,
  .accordion--image .icon-caret > svg {
    display: none;
  }

  .accordion--image .icon-caret::before {
    content: '';
    display: block;
    inline-size: 100%;
    block-size: 100%;
    background: var(--accordion-icon-image) center / contain no-repeat;
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .accordion--image details[open] > summary .icon-caret::before {
    transform: rotate(180deg);
  }

  /* Opt-in: each row is a separate card (background, border, radius, padding) */
  .accordion--cards {
    display: flex;
    flex-direction: column;
    gap: var(--accordion-row-gap);
  }

  .accordion--cards .details {
    background-color: var(--accordion-row-background, transparent);
    border: var(--accordion-row-border-width) solid var(--accordion-row-border-color, var(--color-border));
    border-radius: var(--accordion-row-radius);
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .accordion--cards .details[open] {
    background-color: var(--accordion-row-background-open, var(--accordion-row-background, transparent));
  }

  /* The whole question row stays the click target, so the padding sits on the summary */
  .accordion--cards .details__header {
    gap: var(--accordion-summary-gap);
    padding-block: var(--accordion-row-padding-block);
    padding-inline: var(--accordion-row-padding-inline);
  }

  .accordion--cards .details-content {
    padding-inline: var(--accordion-row-padding-inline);
  }

  .accordion--cards .details[open] > .details__header {
    padding-block-end: var(--accordion-content-gap);
  }

  .accordion--cards .details[open] > .details-content {
    padding-block-end: var(--accordion-row-padding-block);
  }

  /* Row without an answer yet: opening it keeps the closed card size (no empty panel) */
  .accordion--cards .details[open]:not(:has(.details-content *)) > .details__header {
    padding-block-end: var(--accordion-row-padding-block);
  }

  .accordion--cards .details[open]:not(:has(.details-content *)) > .details-content {
    padding-block: 0;
  }

  .accordion--cards summary .svg-wrapper {
    flex-shrink: 0;
    inline-size: var(--accordion-icon-size);
    block-size: var(--accordion-icon-size);

    > svg {
      inline-size: 100%;
      block-size: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .accordion--cards .details {
      --accordion-row-padding-inline: var(--accordion-row-padding-inline-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.accordion",
  "tag": null,
  "class": "accordion",
  "blocks": [
    {
      "type": "_accordion-row"
    }
