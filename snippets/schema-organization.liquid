{%- comment -%} Snosha SEO: Organization JSON-LD, rendered on all pages from layout/theme.liquid {%- endcomment -%}
{%- assign schema_logo = 'https://snosha.com/cdn/shop/files/snosha-logo.png' -%}
{%- if settings.logo != blank -%}
  {%- assign schema_logo = settings.logo | image_url: width: 500 | prepend: 'https:' -%}
{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Snosha",
  "alternateName": "سنوشا",
  "url": "https://snosha.com/",
  "logo": {{ schema_logo | json }},
  "description": "Snosha is an ecommerce brand focused on dental care and oral health products in Egypt.",
  "foundingDate": "2025",
  "founder": {
    "@type": "Person",
    "name": "Ahmed Farhat"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+201116263080",
    "contactType": "customer support",
    "email": "info@snosha.com",
    "areaServed": "EG",
    "availableLanguage": ["Arabic", "English"]
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "EG"
  },
  "sameAs": [
    "https://www.facebook.com/snoshacom/",
    "https://www.instagram.com/snosha_com/"
  ],
  "areaServed": {
    "@type": "Country",
    "name": "Egypt"
  }
}
</script>
