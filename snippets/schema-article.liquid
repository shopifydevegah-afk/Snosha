{%- comment -%} Snosha SEO: Article JSON-LD. Accepts: article {%- endcomment -%}
{%- if article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "inLanguage": {{ request.locale.iso_code | json }},
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 160 | json }},
  {%- if article.image %}
  "image": {
    "@type": "ImageObject",
    "url": {{ article.image | image_url: width: 1200, height: 630, crop: 'center' | prepend: 'https:' | json }}
  },
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Snosha",
    "logo": {
      "@type": "ImageObject",
      "url": "https://snosha.com/cdn/shop/files/snosha-logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ request.origin | append: article.url | json }}
  }
}
</script>
{%- endif -%}
