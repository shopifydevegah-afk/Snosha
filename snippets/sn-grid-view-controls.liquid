{%- doc -%}
  Snosha (opt-in, filters block "Toolbar layout"): grid / list view on desktop. Uses Horizon's own
  results-list/updateLayout (same attribute and sessionStorage); "sn-list" is styled under the section class.

  @example
  {% render 'sn-grid-view-controls' %}
{%- enddoc -%}

<div class="column-options-wrapper sn-view-controls">
  <fieldset class="column-options">
    <legend class="column-options__legend visually-hidden">
      {{ 'content.grid_view.grid_fieldset' | t }}
    </legend>

    <label class="column-options__option sn-view-controls__option">
      <input
        type="radio"
        name="grid"
        value="sn-list"
        class="column-options__option-input"
        aria-label="List"
        on:change="results-list/updateLayout"
        data-skip-node-update
      >
      <span class="column-picker">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M7 4.5h11M7 10h11M7 15.5h11M2 4.5h1.5M2 10h1.5M2 15.5h1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
    </label>

    <label class="column-options__option sn-view-controls__option">
      <input
        type="radio"
        name="grid"
        value="default"
        class="column-options__option-input"
        checked
        aria-label="{{ 'content.grid_view.default_view' | t }}"
        data-grid-layout="desktop-default-option"
        on:change="results-list/updateLayout"
        data-skip-node-update
      >
      <span class="column-picker">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="2" y="2" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          <rect x="12.5" y="2" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          <rect x="2" y="12.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          <rect x="12.5" y="12.5" width="7.5" height="7.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
    </label>
  </fieldset>
</div>
