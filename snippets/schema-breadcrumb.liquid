{%- comment -%} Snosha SEO: BreadcrumbList JSON-LD for product and collection pages. Accepts: product, collection {%- endcomment -%}
{%- if template.name == 'product' or template.name == 'collection' -%}
  {%- assign schema_position = 1 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": {{ request.locale.iso_code | json }},
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "{% if request.locale.iso_code == 'ar' %}الرئيسية{% else %}Home{% endif %}",
      "item": {{ request.origin | append: routes.root_url | json }}
    }
    {%- if collection -%}
      {%- assign schema_position = schema_position | plus: 1 -%},
    {
      "@type": "ListItem",
      "position": {{ schema_position }},
      "name": {{ collection.title | json }},
      "item": {{ request.origin | append: collection.url | json }}
    }
    {%- endif -%}
    {%- if template.name == 'product' and product -%}
      {%- assign schema_position = schema_position | plus: 1 -%},
    {
      "@type": "ListItem",
      "position": {{ schema_position }},
      "name": {{ product.title | json }},
      "item": {{ request.origin | append: product.url | json }}
    }
    {%- endif %}
  ]
}
</script>
{%- endif -%}
